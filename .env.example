# Copy to .env.local and fill in. Next.js loads .env.local on its own.

# z.ai API key (required unless GLM_MOCK=1)
GLM_API_KEY=

# Default: the standard pay-as-you-go endpoint.
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# GLM_MODEL=glm-5.3-flash
# GLM_EFFORT=low            # low | high | max: more thinking, slower answers

# Image model
# PAINTER_SIZE=512          # picture size in pixels
# PAINTER_MODEL=models/flux2-klein-4b-q4
# PAINTER_PORT=7861
# MFLUX_PYTHON=~/.local/share/uv/tools/mflux/bin/python

# Other addresses the app may be opened at, besides localhost (comma separated)
# ALLOWED_HOSTS=192.168.1.20:3000
